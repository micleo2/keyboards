# Boardsource unicorne: let the logged-in user open its raw HID interface, so the
# quickshell bridge (retro/services/qmk/qmk-bridge.py) can talk to it.
# USB ids match host/boards/unicorne.json.  Installed by setup.sh.
# The "70-" keeps this file ahead of 73-seat-late.rules, which is what turns
# the uaccess tag into an ACL for the active seat's user.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="4273", ATTRS{idProduct}=="7563", TAG+="uaccess"
